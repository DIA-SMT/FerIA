// ---------------------------------------------------------------------------
// Ferias Municipales — Municipalidad de San Miguel de Tucumán
// ---------------------------------------------------------------------------
// La base es un proyecto de Supabase (PostgreSQL + PostGIS).
//
// · `Usuario` es el perfil de la aplicación. Las credenciales las administra
//   Supabase Auth en `auth.users`; `Usuario.id` es el mismo UUID que
//   `auth.users.id`. Por eso acá no hay ningún campo de contraseña.
//
// · `Feria.ubicacion` es una columna PostGIS. En Supabase la extensión vive en
//   el schema `extensions`, así que el tipo real de la columna es
//   `extensions.geometry(Point, 4326)`. Prisma no puede leer columnas
//   `Unsupported`, de modo que la geometría se escribe por SQL crudo desde
//   `src/lib/geo.ts` y `latitud`/`longitud` funcionan como espejo legible.
//
// · Todas las tablas tienen RLS habilitado y sin políticas: así PostgREST
//   (la API pública de Supabase, accesible con la anon key) no las expone.
//   Prisma se conecta como dueño de las tablas y no le afecta.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooler de transacciones (puerto 6543): lo usa la aplicación.
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432): la usan las migraciones.
  directUrl = env("DIRECT_URL")
}

// --------------------------------- Enums -----------------------------------

enum Rol {
  ADMIN
  VENDEDOR
}

enum EstadoVendedor {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoEdicion {
  BORRADOR
  PUBLICADA
  EN_CURSO
  FINALIZADA
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  ANULADO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  OTRO
}

/// De dónde salió la ficha del feriante.
///
/// `PROPIO` es quien se registró en esta plataforma. `FERIA_DIGITAL` es el
/// padrón importado de miferiadigital.smt.gob.ar — ver
/// `prisma/importar-feria-digital.ts`. La distinción no es decorativa: una
/// ficha importada no tiene cuenta todavía (`usuarioId` en null) y sus datos
/// los cargó el municipio, no la persona.
enum OrigenVendedor {
  PROPIO
  FERIA_DIGITAL
}

/// Estado de un pedido del vecino a un feriante.
///
/// No hay estado de pago: el municipio no cobra. El dinero se acuerda entre las
/// partes y la plataforma sólo transporta el pedido. Si alguna vez se integra
/// el cobro, va en un modelo aparte y no acá.
enum EstadoPedido {
  /// Enviado al feriante, todavía sin respuesta.
  PENDIENTE
  /// El feriante lo tomó y se comprometió a prepararlo.
  CONFIRMADO
  /// Entregado al vecino.
  ENTREGADO
  /// Cancelado por cualquiera de las dos partes.
  CANCELADO
}

/// Cómo recibe el vecino lo que pidió.
enum ModoEntrega {
  /// Lo retira en el puesto, durante una edición concreta de la feria.
  RETIRO_EN_FERIA
  /// Lo arreglan entre ellos (delivery propio, punto de encuentro, etc.).
  ACUERDA_CON_FERIANTE
}

/// Estado de la postulación de un feriante a una feria.
enum EstadoPostulacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA

  /// El feriante se bajó de la feria por su cuenta.
  ///
  /// Es distinto de RECHAZADA y no se puede mezclar: rechazada es una decisión
  /// de la Dirección y lleva motivo; retirada es del feriante y no le debe
  /// explicación a nadie. Tenerlas separadas es lo que permite que la bandeja
  /// avise «se bajó y todavía tiene el puesto 14 asignado» en vez de hacerlo
  /// pasar por un rechazo que nadie firmó.
  RETIRADA
}

/// Día de la semana en que abre una edición.
///
/// Un enum y no un número: `2` no se lee, y el orden del enum es el orden en
/// que se muestran, que acá empieza en lunes y no en domingo.
enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

/// Categoría general de la feria (define el perfil del evento).
enum CategoriaFeria {
  ARTESANIAS
  EMPRENDEDORES
  GASTRONOMIA
  PRODUCTOS_REGIONALES
  LIBROS_Y_ARTE
  MIXTA
}

/// Rubro del emprendimiento de cada feriante.
enum Rubro {
  ARTESANIAS
  GASTRONOMIA
  INDUMENTARIA
  MARROQUINERIA
  JOYERIA_Y_BIJOUTERIE
  DECORACION
  COSMETICA_NATURAL
  LIBROS_Y_ARTE
  PRODUCTOS_REGIONALES
  HUERTA_Y_VIVERO
  JUGUETES
  OTROS
}

// -------------------------------- Modelos ----------------------------------

/// Perfil de la aplicación. Espeja `auth.users` de Supabase por `id`.
model Usuario {
  /// UUID de la cuenta. Hasta la mudanza lo asignaba Supabase Auth; ahora lo
  /// genera la aplicación. Los de los usuarios que ya existían no cambiaron, y
  /// por eso ninguna relación se tocó.
  id     String @id @db.Uuid
  email  String @unique
  nombre String
  rol    Rol    @default(VENDEDOR)

  /// Contraseña, en bcrypt.
  ///
  /// Nulo a propósito: quien entra por CiDiTuc nunca eligió una, y obligarlo a
  /// tener una inventada sería peor que no tenerla. Sin hash, el ingreso por
  /// contraseña simplemente no es posible para esa cuenta.
  ///
  /// Nunca se selecciona fuera del inicio de sesión. Ver docs/autenticacion.md.
  passwordHash String?

  /// Ningún token emitido antes de este instante vale.
  ///
  /// Es el botón de pánico. Un JWT ya emitido no se puede revocar —ni los de
  /// Supabase podían—, así que la revocación se hace acá: mover esta fecha
  /// invalida todas las sesiones de la cuenta en la siguiente petición. Se
  /// mueve al cambiar la contraseña, al cambiar el rol, y para echar a alguien.
  sesionesValidasDesde DateTime @default(now())

  /// El documento que CiDiTuc verificó, si entró por ahí.
  ///
  /// Antes vivía en el `user_metadata` de Supabase. Es el transporte entre el
  /// ingreso y la encuesta de alta, que lo copia a `Vendedor.dni`, donde queda
  /// de forma permanente.
  ///
  /// Nulo para quien entra con correo y contraseña, y eso es información, no
  /// un faltante: ahí nadie verificó nada contra el padrón municipal.
  documento String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  vendedor Vendedor?

  @@index([rol])
  @@map("usuarios")
}

/// Perfil del feriante. Relación 1-1 con Usuario.
model Vendedor {
  id String @id @default(cuid())

  /// Cuenta que controla esta ficha, cuando alguien la controla.
  ///
  /// Pasó a ser opcional con la importación del padrón de Feria Digital: esas
  /// 867 fichas son registros del municipio que todavía nadie reclamó. Cuando
  /// la persona entre por primera vez (hoy Supabase Auth, mañana CiDiTuc) se le
  /// engancha su `usuarioId` y recién ahí puede editarla.
  ///
  /// Ojo al leer este campo: `usuario` es null en la mayoría de las filas.
  ///
  /// Borrar la cuenta ya no borra la ficha (`SetNull`, antes `Cascade`). Con
  /// `usuarioId` obligatorio el cascade era correcto: sin cuenta no había
  /// feriante. Ahora la ficha es un registro del municipio que la persona
  /// reclama, así que si se da de baja la cuenta lo que corresponde es que la
  /// ficha vuelva a quedar sin reclamar, no que el padrón pierda la fila.
  usuarioId String?  @unique @db.Uuid
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  /// Procedencia de la ficha y su identidad en el sistema de origen.
  ///
  /// `idExterno` es el id del documento en Firestore, que es lo único estable
  /// que publica Feria Digital. Con el par (origen, idExterno) la importación
  /// es idempotente: correrla de nuevo actualiza, no duplica.
  origen            OrigenVendedor @default(PROPIO)
  idExterno         String?
  /// Nombre de la persona a cargo del emprendimiento.
  ///
  /// Normalmente el titular es `usuario.nombre`, pero una ficha del padrón no
  /// tiene cuenta todavía y el nombre del responsable es justamente el dato que
  /// permite que la persona correcta la reclame. Se lee con `titularDe()`.
  nombreResponsable String?
  /// Feria de la que viene en el sistema de origen, ej. "artesanos".
  ///
  /// Es rastro de la importación, no la relación viva: acá la participación se
  /// modela por edición a través de `Stand`, y el padrón no trae ni número de
  /// puesto ni edición. Le sirve a la Dirección para saber a qué feria asignar
  /// a cada uno cuando arme las ediciones.
  feriaOrigen       String?

  // Datos del emprendimiento
  emprendimiento String
  slug           String  @unique
  rubro          Rubro
  descripcion    String?

  // Contacto
  telefono String?
  /// Sólo dígitos con código de país, ej. "5493811234567" (para armar el link wa.me).
  whatsapp String
  email    String?

  // Redes
  instagram String?
  facebook  String?
  sitioWeb  String?

  // Vidriera online — rutas dentro de Supabase Storage, ej. "vendedores/abc.webp"
  imagenPortada String?
  logo          String?

  // Datos administrativos
  dni       String?
  direccion String?

  // Flujo de aprobación municipal
  estado        EstadoVendedor @default(PENDIENTE)
  motivoRechazo String?
  revisadoEn    DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  productos     Producto[]
  stands        Stand[]
  pagos         PagoCanon[]
  pedidos       Pedido[]
  postulaciones Postulacion[]

  // Idempotencia de la importación. Postgres admite varios NULL en un índice
  // único, así que las fichas propias (idExterno null) no chocan entre sí.
  @@unique([origen, idExterno])
  @@index([estado])
  @@index([rubro])
  @@map("vendedores")
}

model Feria {
  id          String         @id @default(cuid())
  nombre      String
  slug        String         @unique
  descripcion String
  categoria   CategoriaFeria

  // Ubicación
  direccion String
  /// Fuente de verdad geográfica (PostGIS). El tipo real es
  /// `extensions.geometry(Point, 4326)`; Prisma no la lee, usar src/lib/geo.ts.
  ubicacion Unsupported("geometry(Point, 4326)")?
  /// Espejo legible de `ubicacion`, mantenido en sincronía por guardarUbicacion().
  latitud   Float?
  longitud  Float?

  /// Ruta dentro de Supabase Storage, ej. "ferias/abc.webp".
  imagen String?
  activa Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  ediciones     EdicionFeria[]
  postulaciones Postulacion[]

  @@index([categoria])
  @@index([activa])
  @@map("ferias")
}

model EdicionFeria {
  id      String @id @default(cuid())
  feriaId String
  feria   Feria  @relation(fields: [feriaId], references: [id], onDelete: Cascade)

  /// Nombre opcional de la edición, ej. "Edición Aniversario".
  nombre      String?
  fechaInicio DateTime    @db.Date
  fechaFin    DateTime    @db.Date
  /// Días de la semana en que abre, ej. `[SABADO, DOMINGO]`.
  ///
  /// Junto con `horaApertura` y `horaCierre` reemplazan a `horario` como
  /// fuente para las tarjetas de la portada: ahí hace falta imprimir «Sáb ·
  /// 8:00 a 14:00», y eso no se puede sacar de una frase en prosa sin
  /// adivinarla.
  diasSemana  DiaSemana[] @default([])

  /// Hora de apertura y de cierre, en formato "HH:MM" de 24 horas.
  ///
  /// Texto y no una columna `TIME` a propósito. Es exactamente lo que produce
  /// y consume un `<input type="time">`, así que no hay conversión en ninguno
  /// de los dos sentidos; ordena bien alfabéticamente; y sobre todo no arrastra
  /// zona horaria, que en este proyecto ya nos costó caro. Una feria abre a las
  /// ocho de la mañana de Tucumán, no a un instante absoluto.
  horaApertura String? @db.VarChar(5)
  horaCierre   String? @db.VarChar(5)

  /// Aclaración de horario en texto libre, ej. "Sábados y domingos de 17 a 23 h".
  ///
  /// Era el único dato de horario y ahora es el complemento: lo que no entra en
  /// días y horas —«se suspende por lluvia», «el último domingo del mes no
  /// abre»— sigue acá. Pasó a opcional para no obligar a repetir en prosa lo
  /// que ya dicen los campos de arriba.
  ///
  /// Mientras una edición no tenga días y horas cargados, la pantalla cae de
  /// nuevo en este texto. Así la Dirección puede ir completando de a poco en
  /// vez de recargar las ferias existentes de golpe.
  horario String?

  estado         EstadoEdicion @default(BORRADOR)
  cantidadStands Int           @default(0)

  /// Canon que debe abonar cada feriante para participar de esta edición.
  montoCanon       Decimal   @default(0) @db.Decimal(12, 2)
  vencimientoCanon DateTime? @db.Date

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  stands  Stand[]
  pagos   PagoCanon[]
  pedidos Pedido[]

  @@index([feriaId])
  @@index([estado])
  @@index([fechaInicio])
  @@map("ediciones_feria")
}

model Stand {
  id        String       @id @default(cuid())
  edicionId String
  edicion   EdicionFeria @relation(fields: [edicionId], references: [id], onDelete: Cascade)

  numero Int
  notas  String?

  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  asignadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Un número de stand no se repite dentro de una edición.
  @@unique([edicionId, numero])
  // Un feriante ocupa como máximo un stand por edición.
  // (Postgres permite múltiples NULL, así que los stands libres no chocan.)
  @@unique([edicionId, vendedorId])
  @@index([vendedorId])
  @@map("stands")
}

model Producto {
  id         String   @id @default(cuid())
  vendedorId String
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String?
  /// Rutas dentro de Supabase Storage, ej. "productos/abc.webp".
  imagenes    String[] @default([])

  /// Precio de lista, en pesos.
  ///
  /// Vuelve después de que `20260814000000_quitar_precio_productos` lo sacara.
  /// Aquella migración documenta una decisión de la Dirección de Ferias y
  /// Mercados: la plataforma es vidriera y no canal de venta. El pedido de
  /// marketplace la revierte, así que la columna existe pero **no se publica**
  /// hasta que esa Dirección y Legales lo confirmen: lo gobierna
  /// `PERMITIR_PRECIOS` (ver `src/lib/marketplace.ts`).
  ///
  /// Nullable porque el padrón importado llega sin precios —el feriante los
  /// carga después— y porque un producto sin precio igual se puede mostrar y
  /// consultar por WhatsApp, que es como funciona hoy. Sin precio no se pide.
  precio Decimal? @db.Decimal(12, 2)
  /// Unidades en venta. `null` es «sin control de stock», que es lo normal en
  /// artesanía y en lo que se hace a pedido; `0` es «no me queda», que es otra
  /// cosa. `disponible` sigue siendo el interruptor manual del feriante.
  stock  Int?

  disponible Boolean @default(true)
  destacado  Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  items ItemPedido[]

  @@index([vendedorId])
  @@index([disponible])
  @@map("productos")
}

/// Registro de canon. Puede haber más de un pago por feriante y edición
/// (pagos parciales); el estado del permiso se deriva de la suma abonada
/// contra `EdicionFeria.montoCanon` y su vencimiento — ver src/lib/canon.ts.
model PagoCanon {
  id String @id @default(cuid())

  vendedorId String
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  edicionId String
  edicion   EdicionFeria @relation(fields: [edicionId], references: [id], onDelete: Cascade)

  monto       Decimal    @db.Decimal(12, 2)
  fechaPago   DateTime?  @db.Date
  medio       MedioPago?
  /// Ruta en el bucket privado `comprobantes`. Se sirve con URL firmada.
  comprobante String?
  estado      EstadoPago @default(PENDIENTE)

  observaciones String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([vendedorId])
  @@index([edicionId])
  @@index([estado])
  @@map("pagos_canon")
}

/// Pregunta hecha al asistente del sitio, guardada de forma anónima para que
/// la Dirección vea qué busca la gente y qué falta en las ferias.
///
/// Anónima en serio: sin IP, sin sesión y sin ningún identificador que permita
/// enlazar dos preguntas de la misma persona. Sólo el texto y cuándo. Está
/// declarado en los términos (sección de datos personales); si alguna vez se
/// agrega un campo acá, hay que actualizar los términos antes.
model ConsultaAsistente {
  id String @id @default(cuid())

  pregunta String @db.VarChar(500)

  creadoEn DateTime @default(now())

  @@index([creadoEn])
  @@map("consultas_asistente")
}

// ------------------------------- Pedidos ------------------------------------
// El vecino arma un carrito y manda un pedido al feriante. El municipio
// publica y transporta: no cobra, no retiene, no garantiza. Por eso acá no hay
// medio de pago, ni comisión, ni estado de acreditación — esos campos
// aparecerían recién si alguna vez se decide integrar el cobro, y esa decisión
// no está tomada (ver el comentario de `Producto.precio`).

/// Pedido de un vecino a un feriante.
///
/// No hay cuenta de comprador a propósito: pedirle registro a alguien que
/// quiere comprar dos empanadas es la forma más rápida de vaciar el canal.
/// Lo que se guarda es el mínimo para que el feriante pueda contestar.
model Pedido {
  id String @id @default(cuid())

  /// Número corto y legible, para que el vecino y el feriante puedan hablar
  /// del mismo pedido por WhatsApp sin leerse un cuid en voz alta.
  numero Int @unique @default(autoincrement())

  vendedorId String
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  // Quién pide. Datos de contacto, no un perfil: se piden para poder entregar
  // y se declaran en los términos.
  compradorNombre   String
  /// Normalizado como el del feriante, sólo dígitos con código de país.
  compradorWhatsapp String
  compradorEmail    String?
  /// Aclaraciones del vecino: talle, color, sin azúcar, a qué hora pasa.
  notas             String?

  modoEntrega ModoEntrega   @default(RETIRO_EN_FERIA)
  /// Edición en la que lo retira, cuando el modo es RETIRO_EN_FERIA.
  edicionId   String?
  edicion     EdicionFeria? @relation(fields: [edicionId], references: [id], onDelete: SetNull)

  estado            EstadoPedido @default(PENDIENTE)
  /// Por qué se canceló, si se canceló. Lo ve el vecino.
  motivoCancelacion String?
  /// Cuándo el feriante lo sacó de PENDIENTE. Sirve para medir cuántos pedidos
  /// quedan sin respuesta, que es el número que dice si el canal funciona.
  respondidoEn      DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  items ItemPedido[]

  @@index([vendedorId])
  @@index([estado])
  @@index([creadoEn])
  @@map("pedidos")
}

/// Una línea del pedido.
///
/// Guarda copia del nombre y del precio al momento de pedir. El precio de un
/// producto cambia y el producto se borra; lo que se pidió no cambia nunca.
///
/// No hay columna `subtotal` ni `total` en `Pedido`, y es deliberado: un total
/// guardado al lado de las líneas que lo componen es dos números que pueden
/// contradecirse. Ya nos pasó con el canon. El total se calcula en un solo
/// lugar, `src/lib/pedidos.ts`, sumando en centavos.
model ItemPedido {
  id String @id @default(cuid())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  /// Queda en null si el feriante borró el producto después de pedirlo.
  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  nombre         String
  precioUnitario Decimal @db.Decimal(12, 2)
  cantidad       Int

  @@index([pedidoId])
  @@index([productoId])
  @@map("items_pedido")
}

/// Postulación de un feriante a una feria.
///
/// Es la pieza que faltaba en el circuito: hasta ahora un feriante se
/// registraba una sola vez, la Dirección lo aprobaba, y después alguien del
/// panel le asignaba un stand a mano sin que el feriante hubiera pedido nada.
/// Funcionaba con once feriantes. Con el padrón de Feria Digital adentro no.
///
/// Va contra la FERIA y no contra la edición a propósito. Lo que se decide acá
/// es «esta persona es feriante de la Feria de Artesanos», que es lo que el
/// feriante ve cuando entra. En qué edición y en qué número de puesto se
/// resuelve después, por `Stand`, que es donde está la capacidad y las fechas:
/// aceptar una postulación no obliga a tener resuelto el mapa de la edición.
model Postulacion {
  id String @id @default(cuid())

  vendedorId String
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  feriaId String
  feria   Feria  @relation(fields: [feriaId], references: [id], onDelete: Cascade)

  estado EstadoPostulacion @default(PENDIENTE)

  /// Lo que el feriante quiera contar: qué lleva, desde cuándo produce, si ya
  /// participó. Es el cuerpo de la encuesta y lo lee quien decide.
  mensaje String?

  /// Por qué se rechazó, si se rechazó. Lo ve el feriante.
  motivoRechazo String?
  revisadoEn    DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Una sola postulación por feriante y por feria: si lo rechazaron y vuelve a
  // postularse, se reabre la misma en vez de acumular filas que cuentan la
  // misma historia dos veces.
  @@unique([vendedorId, feriaId])
  @@index([estado])
  @@map("postulaciones")
}
